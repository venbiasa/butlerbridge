{
  "name": "butlerbridge",
  "version": "0.1.0",
  "description": "Standalone MCP server and CLI for Jenkins that mirrors the tool contract of the Jenkins MCP Server plugin, using the Jenkins REST API.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "butlerbridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "jenkins",
    "mcp",
    "model-context-protocol",
    "cli"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "^2.1.2",
    "ridealong": "github:venbiasa/ridealong#semver:^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
